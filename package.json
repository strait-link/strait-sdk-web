{
  "name": "@strait/sdk-web",
  "version": "0.6.0",
  "description": "Deep linking for the web: deferred match on first visit and click attribution, in a few lines.",
  "keywords": [
    "deep-linking",
    "deferred-deep-linking",
    "attribution",
    "web",
    "dynamic-links"
  ],
  "license": "MIT",
  "author": "The Strait authors",
  "homepage": "https://straitlink.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazingga08/strait-sdk-web.git"
  },
  "bugs": {
    "url": "https://github.com/bazingga08/strait-sdk-web/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "brand": "node scripts/brand.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
